# Токен бота от @BotFather
BOT_TOKEN=

# Ключ с https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Модель на OpenRouter (можно поменять на любую другую)
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Скрытые рассуждения модели (медленнее и съедают лимит ответа)
REASONING=false

# Запасная модель, если основная не ответила (можно оставить пустым)
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Платный поиск в интернете через OpenRouter (true/false) и сколько страниц брать
WEB_SEARCH=false
WEB_MAX_RESULTS=2

# Бесплатный поиск через DuckDuckGo, когда WEB_SEARCH=false
FREE_SEARCH=true
# Платный поиск OpenRouter, если бесплатный ничего не нашёл (около 0,8 цента за такой вопрос)
WEB_SEARCH_FALLBACK=false

# Голосовые сообщения (нужен пакет из requirements-voice.txt) и размер модели Whisper: tiny, base, small
VOICE=true
WHISPER_MODEL=base

# Твой Telegram user id для команды /stats (можно несколько через запятую)
ADMIN_ID=

# Лимиты запросов к нейросети в день: на одного человека и на всех вместе
USER_DAILY_LIMIT=30
GLOBAL_DAILY_LIMIT=300

# Если Telegram или OpenRouter не открываются с сервера: прокси вида
# socks5://user:pass@host:port или http://host:port. Иначе оставь пустым.
PROXY_URL=

DB_PATH=data/bot.db
