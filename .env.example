# Токен бота от @BotFather
BOT_TOKEN=

# Ключ с https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Модель на OpenRouter (можно поменять на любую другую)
OPENROUTER_MODEL=deepseek/deepseek-chat

# Поиск в интернете для ответов (true/false) и сколько страниц брать
WEB_SEARCH=true
WEB_MAX_RESULTS=3

# Лимиты запросов к нейросети в день: на одного человека и на всех вместе
USER_DAILY_LIMIT=30
GLOBAL_DAILY_LIMIT=300

# Если Telegram или OpenRouter не открываются с сервера: прокси вида
# socks5://user:pass@host:port или http://host:port. Иначе оставь пустым.
PROXY_URL=

DB_PATH=data/bot.db
